# 编程教育智能体系统 - 环境变量配置
# 复制此文件为 .env 并填写实际值

# ========== DeepSeek API 配置 ==========
# 从 https://platform.deepseek.com/ 获取API密钥
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ========== Redis 配置 ==========
# 设置为 false 使用 SQLite（开发环境）
USE_REDIS=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ========== 系统配置 ==========
MAX_RETRIES=3
TIMEOUT=30
CACHE_SIZE=1000
DEFAULT_DIFFICULTY=beginner

# ========== 日志配置 ==========
LOG_LEVEL=INFO
LOG_FILE=./logs/system.log

# ========== 性能配置 ==========
LLM_CACHE_TTL=300  # LLM缓存有效期（秒）
MAX_CACHE_SIZE=1000  # 最大缓存条目数
MAX_CONCURRENT_REQUESTS=10  # 最大并发请求数

# ========== 安全配置 ==========
# 输入内容最大长度
MAX_INPUT_LENGTH=5000
# 评估代码最大长度
MAX_CODE_LENGTH=12000
# 用户ID正则验证
USER_ID_PATTERN=^[a-zA-Z0-9_-]{3,50}$
# 是否允许实际执行用户提交的代码。默认建议保持 false。
ENABLE_UNTRUSTED_CODE_EXECUTION=false
# 如果开启代码执行，最大运行时长（秒）
CODE_EXECUTION_TIMEOUT=5

# ========== 后端登录配置 ==========
SERVER_ADMIN_USERNAME=admin
SERVER_ADMIN_PASSWORD=change_me_please
SERVER_TOKEN_EXPIRE_MINUTES=120
SERVER_REFRESH_TOKEN_EXPIRE_DAYS=14
SERVER_APP_DB=./server/runtime/app.db
SERVER_AGENT_CONCURRENCY=32
SERVER_AGENT_QUEUE_TIMEOUT_SECONDS=30
SERVER_WORKERS=1
